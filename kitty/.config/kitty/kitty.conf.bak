confirm_os_window_close 0
font_family FiraCode Nerd Font
font_features FiraCode Nerd Font +calt +ss01 +ss02 +ss03 +ss04 +ss05 +zero
# --- Monochrome Kitty Theme ---
# foreground #eeeeee
# background #000000
# cursor     #ffffff

# Black
# color0  #2e2e2e
# color8  #505050

# Red (we'll make it white)
# color1  #ffffff
# color9  #ffffff

# Green (we'll make it light gray)
# color2  #cccccc
# color10 #cccccc

# Yellow (we'll make it light gray)
# color3  #cccccc
# color11 #cccccc

# Blue (we'll make it white)
# color4  #ffffff
# color13 #ffffff

# Magenta (we'll make it light gray)
# color5  #cccccc
# color12 #cccccc

# Cyan (we'll make it light gray)
# color6  #cccccc
# color14 #cccccc

# White
# color7  #ffffff
# color15 #ffffff

# --- End of Theme ---


# BEGIN_KITTY_THEME
# Rosé Pine
include current-theme.conf
