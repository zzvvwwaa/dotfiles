{
    "layer": "top",
    "position": "top",
    "height": 34,

    // Define the module layout
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/cava",
	"disk",
        "memory",
        "cpu",
        "battery",
        "pulseaudio",
	"custom/bluetooth",
        "network",
        "tray"
    ],

    // --- Module Settings ---
    "hyprland/workspaces": {
    	"format": "{name}",        // This forces it to show the number (name) instead of an icon
    	"on-click": "activate",
    	"persistent-workspaces": {
        "*": [1, 2, 3, 4]      // Always show workspaces 1, 2, 3, and 4 on every monitor
    }
    },
    
    "clock": {
	"format": " {:%I:%M %p}"
    },
    "disk": {
        "format": " {}%", // Shows used percentage
        "path": "/"
    },
    "memory": {
        "format": " {}%" // RAM usage
    },
    "cpu": {
        "format": " {usage}%",
	"on-click": "kitty --title waybtop -e btop --force-utf"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "kitty --title pulsemixer -e pulsemixer"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "",
        "format-disconnected": "⚠",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
	"on-click": "kitty --title nmtui-float -e nmtui"
    },
    "tray": {
        "spacing": 10
    },
    "custom/bluetooth": {
    	"format": "",
    	"tooltip-text": "Bluetooth Control",
    	"on-click": "kitty --title bluetooth-float -e bluetui"
    },
    "custom/cava": {
    "exec": "~/.config/waybar/cava.sh",
    "format": "{}",
    "tooltip": false,
    "on-click": "kitty -e cava" // Opens volume control on click
    },
}
