{
    "layer": "top",
    "position": "top",
    "height": 30,

    // Define the module layout
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "disk",
        "memory",
        "cpu",
        "battery",
        "pulseaudio",
	"custom/bluetooth",
        "network",
        "tray"
    ],

    // --- Module Settings ---
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "○",
            "active": "●"
        }
    },
    "clock": {
        "format": " {:%H:%M}"
    },
    "disk": {
        "format": " {}%", // Shows used percentage
        "path": "/"
    },
    "memory": {
        "format": " {}%" // RAM usage
    },
    "cpu": {
        "format": " {usage}%"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "",
        "format-disconnected": "⚠",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
	"on-click": "kitty --title nmtui-float -e nmtui"
    },
    "tray": {
        "spacing": 10
    },
    "custom/bluetooth": {
    	"format": "",
    	"tooltip-text": "Bluetooth Control",
    	"on-click": "kitty --title bluetooth-float -e bluetoothctl"
    },
}
